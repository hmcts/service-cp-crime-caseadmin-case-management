import uk.gov.moj.cpp.authz.drools.Outcome;
import uk.gov.moj.cpp.authz.drools.Action;

global uk.gov.moj.cpp.authz.http.providers.UserAndGroupProvider userAndGroupProvider;

// POST /groupcases: prosecution-casefile creates the group case when a group submission is
// received. System user only (CAD-1849).
rule "Allow – create group case"
when
  $o: Outcome()
  $a: Action(name == "casemanagement-service.create-group-case")
  eval(userAndGroupProvider.isMemberOfAnyOfTheSuppliedGroups($a, "System Users"))
then
  $o.setSuccess(true);
end

// GET /groupcases/{groupId}: view a group case and its current active member cases (CAD-1855).
rule "Allow – view group case"
when
  $o: Outcome()
  $a: Action(name == "casemanagement-service.view-group-case")
  eval(userAndGroupProvider.isMemberOfAnyOfTheSuppliedGroups($a,
          "System Users", "Legal Advisers", "Court Associate", "Court Administrators"))
then
  $o.setSuccess(true);
end

// GET /groupcases/search: search group cases by court centre and hearing date range (CAD-1851).
rule "Allow – search group cases"
when
  $o: Outcome()
  $a: Action(name == "casemanagement-service.search-group-cases")
  eval(userAndGroupProvider.isMemberOfAnyOfTheSuppliedGroups($a,
          "System Users", "Legal Advisers", "Court Associate", "Court Administrators"))
then
  $o.setSuccess(true);
end
